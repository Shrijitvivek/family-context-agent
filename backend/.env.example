APP_NAME=Family Context Agent
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO
API_V1_PREFIX=/api/v1
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=family_context_agent
POSTGRES_USER=family_agent
POSTGRES_PASSWORD=change_me
DATABASE_URL=postgresql+asyncpg://family_agent:change_me@localhost:5432/family_context_agent

FAMILY_TIMEZONE=Asia/Kolkata
DEMO_FAMILY_NAME=Nair Family

NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.studio.nebius.ai/v1/
NVIDIA_MODEL_NAME=

STORAGE_BACKEND=local
UPLOAD_DIR=storage/uploads
MAX_UPLOAD_SIZE_MB=10
ALLOWED_UPLOAD_TYPES=application/pdf,image/jpeg,image/png

SCHEDULER_ENABLED=true
DEADLINE_CHECK_INTERVAL_MINUTES=15

VITE_API_BASE_URL=http://localhost:8000/api/v1
