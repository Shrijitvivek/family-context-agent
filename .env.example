APP_NAME=Family Context Agent
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO
API_V1_PREFIX=/api/v1
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173

POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=family_context_agent
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me
DATABASE_URL=postgresql+asyncpg://postgres:change_me@db:5432/family_context_agent
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

FAMILY_TIMEZONE=Asia/Kolkata
DEMO_FAMILY_NAME=Nair Family

NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.studio.nebius.ai/v1/
NVIDIA_MODEL_NAME=nvidia/nemotron-3-super-120b-a12b
VISION_MODEL_NAME=openbmb/MiniCPM-V-4_5

STORAGE_BACKEND=local
UPLOAD_DIR=/app/storage/uploads
MAX_UPLOAD_SIZE_MB=10
ALLOWED_UPLOAD_TYPES=application/pdf,image/jpeg,image/png

SCHEDULER_ENABLED=true
DEADLINE_CHECK_INTERVAL_MINUTES=15

VITE_API_BASE_URL=/api/v1